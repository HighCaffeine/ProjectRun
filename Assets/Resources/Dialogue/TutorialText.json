{
  "lines": [
    {
      "speaker": "사채업자",
      "text": "아무것도 모르는 듯하네요.",
      "portrait": 5
    },
    {
      "speaker": "사채업자",
      "text": "그럴 줄은 알았지만요.",
      "portrait": 4
    },
    {
      "speaker": "사채업자",
      "text": "W, A, S, D로 이동.",
      "portrait": 0
    },
    {
      "speaker": "사채업자",
      "text": "생각보다 복잡하진 않죠?",
      "portrait": 4
    },
    {
      "speaker": "사채업자",
      "text": "좌클릭은 밀치기.",
      "portrait": 0
    },
    {
      "speaker": "사채업자",
      "text": "우클릭은 당기기.",
      "portrait": 0
    },
    {
      "speaker": "사채업자",
      "text": "사람을 밀든, 끌어오든.",
      "portrait": 2
    },
    {
      "speaker": "사채업자",
      "text": "그 결과까지 제가 책임지진 않아요.",
      "portrait": 4
    },
    {
      "speaker": "사채업자",
      "text": "이 정도는 기억하실 수 있을 거예요.",
      "portrait": 1
    },
    {
      "speaker": "사채업자",
      "text": "아마도.",
      "portrait": 4
    },
    {
      "speaker": "사채업자",
      "text": "아, 그리고 던전으로 가려면 아래에 있는 배에 탑승하시면 돼요.",
      "portrait": 0
    },
    {
      "speaker": "사채업자",
      "text": "어디로 가야 할지 모르겠다는 말은 하지 않으셨으면 좋겠네요.",
      "portrait": 4
    },
    {
      "speaker": "사채업자",
      "text": "어느 배인지까지 자세히 설명할 필요는 없겠죠?",
      "portrait": 4
    },
    {
      "speaker": "사채업자",
      "text": "그 정도는 구분하실 수 있을 거라고 생각할게요.",
      "portrait": 4
    }
  ]
}