{
  "lines": [
    {
      "speaker": "사채업자",
      "text": "어머나?",
      "portrait": 0
    },
    {
      "speaker": "사채업자",
      "text": "이번에 새로운 채무자가 온다더니.",
      "portrait": 1
    },
    {
      "speaker": "사채업자",
      "text": "당신들이었나보네요.",
      "portrait": 2
    },
    {
      "speaker": "사채업자",
      "text": "간단하게 조언을 해줄게요.",
      "portrait": 1
    },
    {
      "speaker": "사채업자",
      "text": "WASD로 움직일 수 있어요.",
      "portrait": 0
    },
    {
      "speaker": "사채업자",
      "text": "좌클릭은 밀치기, 우클릭은 당기기.",
      "portrait": 0
    },
    {
      "speaker": "사채업자",
      "text": "사람이나 물체에 시도해보세요.",
      "portrait": 0
    },
    {
      "speaker": "사채업자",
      "text": "그렇게 어렵지는 않죠?",
      "portrait": 2
    },
    {
      "speaker": "사채업자",
      "text": "임무 내용은 간단해요.",
      "portrait": 3
    },
    {
      "speaker": "사채업자",
      "text": "지하 던전을 탐색하는 것.",
      "portrait": 3
    },
    {
      "speaker": "사채업자",
      "text": "아래로 이동하면 그 곳까지 타고 갈 비공정이 있어요.",
      "portrait": 1
    },
    {
      "speaker": "사채업자",
      "text": "비행선이라고도 불리죠.",
      "portrait": 0
    },
    {
      "speaker": "사채업자",
      "text": "혼자서는 출발할 수 없을테니 함께 출발하도록 하세요.",
      "portrait": 3
    },
    {
      "speaker": "사채업자",
      "text": "그럼 행운을 빌게요.",
      "portrait": 2
    }
  ]
}